DATABASE_URL=postgresql://coffee_cloud:replace-me@127.0.0.1:5432/coffee_cloud_mvp
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
TELEMETRY_HISTORY_MODE=latest
BOOTSTRAP_DEVICE_ENABLED=false
# Legacy one-device bootstrap only; leave disabled in normal multi-device deployments.
DEVICE_ID=coffee-bot-002
DEVICE_SERIAL_NUMBER=002
DEVICE_INSTANCE_ID=instance-coffee-bot-002
DEVICE_STORE_ID=store-demo-taipei-02
DEVICE_TOKEN=replace-with-a-random-per-device-token
ADMIN_TOKEN=replace-with-a-separate-random-admin-token
ACTIVATION_TTL_SECONDS=600
ACTIVATION_MAX_ATTEMPTS=5
CREDENTIAL_GRACE_SECONDS=300
OFFLINE_THRESHOLD_SECONDS=30
OFFLINE_SCAN_SECONDS=2
PUBLIC_BASE_URL=https://coffee-api.woodbridge.top
PUBLIC_ORDER_QUEUE_LIMIT=20
DEFAULT_PRODUCT_PRICE_MINOR=100
PAYMENT_DEFAULT_PROVIDER=mock
PUBLIC_PAYMENT_MODE=TEST_FREE
ALLOW_MOCK_PAYMENT=false
PAYMENT_CURRENCY=CNY
PAYMENT_RECONCILE_SECONDS=30
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_FILE=/run/secrets/alipay/app-private-key.pem
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay/alipay-public-key.pem
ALIPAY_TIMEOUT_SECONDS=15
INTERNAL_GATEWAY_TOKEN=replace-with-an-independent-random-gateway-token
OUTBOX_SCAN_SECONDS=0.5
COMMAND_PUBLISH_LEASE_SECONDS=30
COMMAND_ACK_TIMEOUT_SECONDS=30
COMMAND_START_TIMEOUT_SECONDS=60
PRODUCTION_TIMEOUT_GRACE_SECONDS=120
EMQX_MANAGEMENT_URL=http://127.0.0.1:18083/api/v5
EMQX_DASHBOARD_USERNAME=
EMQX_DASHBOARD_PASSWORD=
ORDER_ACCESS_SECRET=replace-with-an-independent-random-32-byte-secret
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8788
LOG_LEVEL=INFO
